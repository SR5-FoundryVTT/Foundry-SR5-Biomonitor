<div class="flex flex-col h-full w-full overflow-hidden text-[var(--text-color-primary)]">
  <!-- Header matching the Marketplace style -->
  <header class="marketplace-header flex flex-row items-center gap-3 shrink-0 rounded p-2 mb-3 bg-[var(--header-gradient-bar)] text-[var(--header-gradient-text)]">
    <div class="shrink-0 flex items-center justify-center w-10 h-10 rounded-lg bg-black/25 text-[var(--color-yellow-base)] border border-[var(--color-yellow-dark)] shadow">
      <i class="fas fa-heartbeat text-xl animate-pulse"></i>
    </div>
    <div class="flex-grow">
      <h1 class="text-2xl font-bold m-0 leading-none drop-shadow">
        {{localize "BioMon"}}
      </h1>
    </div>
  </header>

  <!-- Actors List -->
  <div class="flex flex-col gap-2 p-1 overflow-y-auto flex-grow">
    {{#each actors}}
      <div class="sr5-biomon-actors-box flex flex-row items-center gap-3 p-2 rounded-lg border border-[var(--border-color-medium)] bg-black/20 hover:bg-black/40 hover:border-[var(--color-yellow-base)] hover:shadow-[0_0_8px_var(--color-yellow-light)] transition-all cursor-pointer" 
           data-action="openActorSheet" 
           data-actor-uuid="{{this.id}}">
        
        <!-- Actor Avatar and Name Overlay -->
        <div class="relative w-16 h-16 shrink-0 rounded-lg overflow-hidden border border-[var(--border-color-medium)] bg-black/30">
          <img class="w-full h-full object-cover" src="{{this.image}}" title="{{this.name}}" />
          
          {{#if heartbeat}}
            <!-- Heartbeat Video Overlay -->
            <video class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-80 pointer-events-none" autoplay loop muted>
              <source src="{{heartbeat}}" type="video/webm">
            </video>
          {{/if}}
        </div>

        <!-- Character Info and Tracks -->
        <div class="flex-grow flex flex-col justify-between min-w-0">
          <div class="text-sm font-bold truncate text-[var(--text-color-primary)] mb-1" title="{{this.name}}">
            {{this.name}}
          </div>

          <!-- Damage Tracks -->
          <div class="flex flex-col gap-1.5">
            <!-- Stun Track (Top) -->
            <div class="flex flex-row flex-wrap gap-1 items-center">
              <i class="fas fa-kit-medical text-[10px] text-blue-400 w-3.5 shrink-0 text-center" title="Stun Damage"></i>
              <div class="flex flex-row flex-wrap gap-0.5">
                {{#for 0 this.stunTrack.value}}
                  <div class="w-3 h-3 rounded-sm sr5-biomon-stun-filled" title="Stun Damage"></div>
                {{/for}}
                {{#for this.stunTrack.value this.stunTrack.max}}
                  <div class="w-3 h-3 bg-black/40 border border-gray-600/50 rounded-sm" title="Stun Track"></div>
                {{/for}}
              </div>
              {{#if this.stunModifier}}
                <span class="ml-1 px-1 py-[1px] text-[8px] font-bold rounded sr5-biomon-stun-filled leading-none text-white shadow-sm border border-blue-800" title="Stun Wound Modifier">
                  {{this.stunModifier}}
                </span>
              {{/if}}
            </div>

            <!-- Physical Track (Bottom) -->
            <div class="flex flex-row flex-wrap gap-1 items-center">
              <i class="fas fa-heart-pulse text-[10px] text-red-500 w-3.5 shrink-0 text-center" title="Physical Damage"></i>
              <div class="flex flex-row flex-wrap gap-0.5">
                {{#for 0 this.physTrack.value}}
                  <div class="w-3 h-3 rounded-sm sr5-biomon-phys-filled" title="Physical Damage"></div>
                {{/for}}
                {{#for this.physTrack.value this.physTrack.max}}
                  <div class="w-3 h-3 bg-black/40 border border-gray-600/50 rounded-sm" title="Physical Track"></div>
                {{/for}}
              </div>
              {{#if this.physModifier}}
                <span class="ml-1 px-1 py-[1px] text-[8px] font-bold rounded sr5-biomon-phys-filled leading-none text-white shadow-sm border border-red-800" title="Physical Wound Modifier">
                  {{this.physModifier}}
                </span>
              {{/if}}
            </div>
          </div>
        </div>

        <!-- Status Effects -->
        <div class="flex flex-row flex-wrap gap-1 items-center justify-end max-w-[100px] shrink-0">
          {{#each this.statuses}}
            <div class="w-6 h-6 rounded-md overflow-hidden bg-black/30 border border-gray-700/50 flex items-center justify-center" title="{{localize this.name}}">
              <img class="w-5 h-5 object-contain" src="{{this.img}}">
            </div>
          {{/each}}
        </div>

      </div>
    {{/each}}
  </div>
</div>